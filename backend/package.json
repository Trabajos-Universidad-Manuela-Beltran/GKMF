{
  "name": "gkmf-backend",
  "version": "0.2.0",
  "private": true,
  "description": "API REST de GKMF (Garantía de Conocimiento y Movilidad Financiera). Estructura inicial del backend - Fase II.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:integracion": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.integracion.config.ts",
    "token:dev": "tsx --env-file=.env scripts/token-dev.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mssql": "^12.7.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.13.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}

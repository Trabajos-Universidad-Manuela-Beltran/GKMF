# ============================================================================
# GKMF backend - variables de entorno
# Copie este archivo a ".env" y complete los valores.
# NUNCA suba ".env" al repositorio (ya está en .gitignore).
# La aplicación valida estas variables al arrancar y NO inicia si son inválidas.
# ============================================================================

# --- Servidor ---------------------------------------------------------------
# development | test | production. Si se omite se asume production (la opción más estricta).
# Use "development" únicamente en su equipo; en producción cambie también DB_TRUST_SERVER_CERTIFICATE a false.
NODE_ENV=development
# Por defecto escucha solo en la interfaz local. Use 0.0.0.0 únicamente dentro de un contenedor.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Orígenes web permitidos por CORS, separados por comas. Vacío = ninguno (la app móvil no lo necesita).
CORS_ORIGINS=
# Número de proxies de confianza delante de la API (0 = ninguno). Afecta la IP usada por el limitador.
TRUST_PROXY=0
# Limitador de solicitudes por IP (ventana en milisegundos y máximo de solicitudes en la ventana).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Base de datos SQL Server -----------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=GKMF
# Use la cuenta de mínimo privilegio creada con database/04_seguridad_rol_api.sql (NO use "sa").
DB_USER=gkmf_api
DB_PASSWORD=
DB_ENCRYPT=true
# true SOLO en desarrollo local con certificado autofirmado (el contenedor de Docker lo usa).
# En producción debe ser false: la aplicación se niega a arrancar si es true.
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_TIMEOUT_MS=15000

# --- Tokens JWT ---------------------------------------------------------------
# Mínimo 32 caracteres aleatorios. Genere uno con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=gkmf-api
JWT_AUDIENCE=gkmf-app
# Vida del token de acceso en segundos (60 a 3600).
JWT_ACCESS_TTL_SECONDS=900

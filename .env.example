# ============================================================================
# GKMF - variables para docker compose (raíz del repositorio)
# Copie este archivo a ".env" y complete los valores. NUNCA suba ".env".
# Si un valor contiene "#" o espacios, enciérrelo entre comillas dobles.
# ============================================================================

# Clave del administrador (sa) del SQL Server del contenedor.
# SQL Server exige mínimo 8 caracteres con 3 de 4 tipos (mayúscula, minúscula, número, símbolo).
MSSQL_SA_PASSWORD=

# Clave de la cuenta de mínimo privilegio "gkmf_api" que usa el backend.
# Mínimo 16 caracteres, sin comilla simple ('). Si se deja vacía no se crea la cuenta.
GKMF_API_PASSWORD=

# Secreto para firmar los tokens JWT de la API (mínimo 32 caracteres). Genere uno con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Puertos publicados en localhost (opcionales).
DB_HOST_PORT=1433
API_HOST_PORT=3000

# Límite de solicitudes de registro e inicio de sesión por IP cada 15 minutos (por defecto 20).
# Súbalo solo para repetir pruebas automáticas; en uso normal deje el valor por defecto.
# AUTH_RATE_LIMIT_MAX=20

# Límite general de solicitudes por IP cada 15 minutos (por defecto 300). Súbalo solo para mediciones de rendimiento.
# RATE_LIMIT_MAX=300
